    {
      "pattern": "\\b(?:closed|shut|blocked|cordoned off)\\b[^.]{0,40}?\\b(?:after|following|due to)\\b[^.]{0,40}?\\b(?:accident|crash|collision|fire|collapse|cave-?in|gas leak|pipe(?:line)? burst|landslide|tree fall|fallen tree)s?\\b",
      "label": "closed after an accident/collapse",
      "weight": 3,
