# JSAN Road Event Intelligence — backend configuration.
# Copy to `.env` (which is git-ignored) and fill in real values. Never commit `.env`.
# The web app has its own optional settings in frontend/.env.example.

# --- Database ---------------------------------------------------------------
# Password for the PostgreSQL/PostGIS container started by docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Where the API stores its data. PostgreSQL with PostGIS is the target database.
# Leave this unset to use a zero-setup local SQLite file (backend/.data/rei.db),
# which is convenient for development but has no PostGIS.
# URL-encode any special characters in the password.
# DATABASE_URL=postgresql+psycopg://rei:change-me@localhost:5432/rei

# Host port of the PostGIS container (docker-compose.yml). Change it when 5432
# is already used by another PostgreSQL on this machine.
# REI_DB_PORT=5432

# --- GIS road network (optional) ----------------------------------------------
# A PostGIS database for the OpenStreetMap road network used by the GIS
# Resolution Engine (docs/gis-resolution-engine.md). Unset: GIS resolution is
# off and everything else works as before.
# GIS_DATABASE_URL=postgresql+psycopg://rei:change-me@localhost:5432/rei_gis

# Apply database migrations when the API starts (true/false).
AUTO_MIGRATE=true

# --- API ----------------------------------------------------------------------
# Browser origins allowed to call the API directly, comma-separated.
CORS_ORIGINS=http://localhost:3000

# --- Reviewer authentication --------------------------------------------------
# REI has exactly two accounts (decision 0032), each created once from these
# values on API startup and never changed by a restart. There is no sign-up.
# Use real, different emails and unique, long passwords; do not commit your .env.
# The Admin: manages REI, reviews events and runs sources.
# SEED_ADMIN_EMAIL=your-real-email@example.com
# SEED_ADMIN_PASSWORD=generate-a-unique-random-password-at-least-8-characters
# The User: signs in to view the console; changes nothing.
# SEED_USER_EMAIL=another-real-email@example.com
# SEED_USER_PASSWORD=generate-another-unique-random-password-at-least-8-characters
# Use true when serving the web app over HTTPS. Local HTTP development uses false.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12

# --- Ingestion ----------------------------------------------------------------
# Poll active sources in the background at each source's own frequency (true/false).
INGESTION_SCHEDULER_ENABLED=true

# How REI identifies itself to the sources it reads.
# HTTP_USER_AGENT=JSAN-REI/1.0 (road event intelligence; RSS reader)

# Optional replacement for services/extraction/config/traffic_keywords.json.
# TRAFFIC_KEYWORDS_PATH=

# --- Google News search (Serper.dev) ------------------------------------------
# API key for the "Google News search" source. With it, REI runs twelve
# Hyderabad road searches every eight hours (36 Serper credits a day). Without
# it the source is listed as not connected and nothing is searched.
# SERPER_API_KEY=

# --- Connected official/open-data feeds ---------------------------------------
# TfL, Toronto, Mumbai, Bengaluru, NYC (DOT closures, permitted events), France
# (Bison Futé, DiaLog, Lyon) and Finland are connected. Run any one
# by hand with python backend/cli/ingest_source.py <source_id>. Set true to poll
# every connected official feed on its source-specific schedule (15 min–24 h).
# OFFICIAL_FEEDS_SCHEDULED=false
# Or name only the official feeds to poll on their schedules, comma-separated
# (decision 0028), e.g. tfl-road-disruptions,toronto-road-restrictions
# OFFICIAL_FEEDS_SCHEDULED_SOURCES=
# Records one run keeps (in effect now or within a week, most recent first);
# 0 keeps every record. Larger NYC and France feeds are not capped.
# OFFICIAL_FEED_MAX_RECORDS=30

# Days the full text of an article that is not a road event is kept; then a
# small stub remains so it is not stored again. 0 keeps the text for ever.
# UNRELATED_ARTICLE_TEXT_DAYS=14
# Optional free TfL app key: raises TfL's limit from 50 to 500 requests a minute.
# TFL_APP_KEY=

# --- AI reading of articles (OpenRouter) ---------------------------------------
# A language model reads each news article and returns its intent, impact,
# cause, places with their roles and dates as JSON; REI keeps only what the
# article itself contains (docs/decisions/0020-ai-reading-of-articles.md).
# Unset: no article is sent anywhere and keyword rules alone decide.
# OPENROUTER_API_KEY=
# AI_MODEL=google/gemma-4-26b-a4b-it:free
# Comma-separated models OpenRouter tries in turn when the first is busy.
# AI_FALLBACK_MODELS=google/gemma-4-31b-it:free
# AI_REASONING=true
# Requests per day (UTC). A free OpenRouter key allows 50.
# AI_DAILY_REQUEST_LIMIT=40
# Days of stored articles read automatically.
# AI_LOOKBACK_DAYS=2
# AI_TICK_SECONDS=300
# Sources never sent to a model: their terms forbid it.
# AI_EXCLUDED_SOURCES=siasat,siasat-mumbai
# AI_READING_ENABLED=true

# --- Placing events on the map ---------------------------------------------------
# Names the OpenStreetMap place list cannot place are looked up on Google Maps
# through Serper.dev (SERPER_API_KEY), checked, and cached; each name once
# (docs/decisions/0021-placement-osm-first-google-fallback.md).
# PLACE_LOOKUP_GOOGLE=true
# Serper credits a day for place lookups (/places 1, /maps 3).
# PLACE_LOOKUP_DAILY_CREDITS=60

# --- Google News RSS -----------------------------------------------------------
# Built but blocked: each feed says it is for personal, non-commercial use in a
# feed reader only. Do not set true without written permission.
# GOOGLE_NEWS_RSS_ENABLED=false

# --- Sources that still need access or terms review ---------------------------
# Credentials belong here, never in source code. These sources are not fetched
# until an integration and its source terms have been enabled in REI.
# TOMTOM_API_KEY=
# HERE_API_KEY=
# QLDTRAFFIC_API_KEY=
# LTA_ACCOUNT_KEY=
# 511_API_KEY=
