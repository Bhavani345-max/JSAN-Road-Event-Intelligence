# REI web app — optional settings. Copy to `.env.local` to override a default.

# Where the web server forwards /api requests (the REI API). Server-side only.
# Read when the app is built or the dev server starts.
API_BASE_URL=http://127.0.0.1:8000

# MapLibre style JSON URL for the basemap.
# Defaults to OpenFreeMap "positron" (free, no API key).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# XYZ raster tile URL template (and its attribution) for satellite view.
# Defaults to Esri World Imagery (no API key; subject to Esri's terms of use).
# NEXT_PUBLIC_SATELLITE_TILES_URL=
# NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
